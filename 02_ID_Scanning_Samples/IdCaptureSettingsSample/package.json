{
  "name": "id-capture-settings-sample",
  "displayName": "WebIdCaptureSettingsSample",
  "author": "Scandit",
  "description": "IdCaptureSettingsSample for the Web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "npm run check-types && vite build",
    "check-types": "tsc && svelte-check --tsconfig ./tsconfig.json",
    "fast-build": "vite build",
    "serve": "vite preview",
    "lint": "biome lint .",
    "format": "biome format . && prettier --write --plugin-search-dir=. '**/*.svelte'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@iconify-icons/material-symbols": "^1.2.25",
    "@iconify/svelte": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^2.0.0",
    "@tsconfig/svelte": "^3.0.0",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^20.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "autoprefixer": "^10.4.14",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.0",
    "npm-packlist": "^5.1.3",
    "postcss": "^8.4.23",
    "prettier": "^2.8.3",
    "prettier-plugin-svelte": "^2.9.0",
    "svelte": "^3.54.0",
    "svelte-check": "^2.10.3",
    "tailwind-merge": "^1.12.0",
    "tailwindcss": "^3.3.1",
    "tslib": "^2.4.1",
    "typescript": "^4.9.3",
    "vite": "^4.3.9",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-static-copy": "^0.16.0"
  },
  "dependencies": {
    "@scandit/web-datacapture-core": "8.6.0",
    "@scandit/web-datacapture-id": "8.6.0",
    "history": "^5.3.0",
    "svelte-navigator-no-postinstall": "3.2.4"
  },
  "packageManager": "pnpm@11.5.2"
}
