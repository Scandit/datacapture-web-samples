{
  "name": "electron-barcode-capture-simple-sample",
  "version": "1.0.0",
  "description": "A minimal Electron Barcode Capture Scandit application with TypeScript",
  "main": "./out/main/index.js",
  "author": "scandit.com",
  "appId": "com.scandit.electron-barcode-capture-simple-sample",
  "desktopName": "com.scandit.electron-barcode-capture-simple-sample.desktop",
  "homepage": "https://www.scandit.com/",
  "build": {
    "productName": "ElectronBarcodeCaptureSimpleSample",
    "appId": "com.scandit.electron-barcode-capture-simple-sample",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.js,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}"
    ],
    "asarUnpack": [
      "resources/**",
      "sdc-license.data"
    ],
    "win": {
      "executableName": "ElectronBarcodeCaptureSimpleSample"
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always"
    },
    "mac": {
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": [
        {
          "NSCameraUsageDescription": "Application requests access to the device's camera."
        },
        {
          "NSMicrophoneUsageDescription": "Application requests access to the device's microphone."
        },
        {
          "NSDocumentsFolderUsageDescription": "Application requests access to the user's Documents folder."
        },
        {
          "NSDownloadsFolderUsageDescription": "Application requests access to the user's Downloads folder."
        }
      ],
      "notarize": false
    },
    "dmg": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "scandit.com",
      "category": "Utility",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://example.com/auto-updates"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "node --test",
    "e2e": "E2E_TESTS=true npx playwright test",
    "lint": "biome lint .",
    "format": "biome format .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "clean": "rm -rvf out dist .env .env.production e2e-videos sdc-license.data",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "create-license-data": "node encryptLicenseAndCreatePublicKey.mjs",
    "build": "npm run test && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:electron": "node scripts/ensureElectron.cjs",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "~3.0.2",
    "@electron-toolkit/utils": "~3.0.0",
    "@scandit/web-datacapture-barcode": "8.6.0",
    "@scandit/web-datacapture-core": "8.6.0",
    "electron-updater": "~6.6.2",
    "express": "~4.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "~1.52.0",
    "@types/node": "~22.15.17",
    "chalk": "^5.4.1",
    "dotenv": "~16.5.0",
    "electron": "~36.2.0",
    "electron-builder": "~26.15.3",
    "electron-playwright-helpers": "~1.7.1",
    "electron-vite": "^6.0.0-beta.1",
    "playwright": "~1.52.0",
    "typescript": "~5.4.5",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "packageManager": "pnpm@11.5.2"
}
